# OSM extract for Munich region (smaller/faster than full Bayern).
OSM_PBF_URL=https://download.geofabrik.de/europe/germany/bayern/oberbayern-latest.osm.pbf
OSM_PBF_FILE=oberbayern-latest.osm.pbf

# Must match the derived base name from OSM_PBF_FILE (without .osm.pbf)
OSRM_BASE_NAME=oberbayern-latest

# Optional: local service endpoints for Python planner adapter
# export TRISAR_OSM_NOMINATIM_URL=http://127.0.0.1:8088
# export TRISAR_OSM_OSRM_URL=http://127.0.0.1:5001
