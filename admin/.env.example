# Datenquelle: demo (Mock, Standard) oder supabase (echte Datenbank).
# npm run dev:live / build:live setzen supabase automatisch.
VITE_DATENQUELLE=demo
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_KI_PROVIDER=ollama
VITE_OLLAMA_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=llama3.1:8b
VITE_OLLAMA_EMBED_MODEL=nomic-embed-text
VITE_OLLAMA_EMBED_ENDPOINT=/api/embeddings
VITE_PGVECTOR_ENABLED=true
VITE_RAG_MATCH_COUNT=8
VITE_RAG_MIN_SIMILARITY=0.42
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
TELTONIKA_TCP_HOST=0.0.0.0
TELTONIKA_TCP_PORT=5027
TELTONIKA_HEALTH_PORT=8788
TELTONIKA_SOURCE=teltonika_fmb010
TELTONIKA_BLOCK_NO_GPS_FIX_FOR_LIVE=false
TELTONIKA_COMMAND_DEFAULT=getgps
TELTONIKA_COMMAND_RESPONSE_TIMEOUT_MS=15000
# Optional: set token to protect POST /command (header: x-command-token)
# TELTONIKA_COMMAND_TOKEN=change_me
LOG_LEVEL=info
